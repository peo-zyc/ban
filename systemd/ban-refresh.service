[Unit]
Description=ban: refresh domain IP mappings and expire old rules
ConditionPathExists=/etc/ban/rules.conf
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/local/bin/ban refresh --quiet
ExecStart=/usr/local/bin/ban gc --quiet
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ReadWritePaths=/etc/ban /etc/hosts /etc/dnsmasq.d /var/log
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
